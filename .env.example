# ════════════════════════════════════════════════
# HOSPITAL-AI — Railway Production Environment
# Copy file này, điền giá trị thật vào Railway Dashboard
# ════════════════════════════════════════════════

# Database MySQL (Railway cung cấp tự động nếu add MySQL plugin)
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/hospital_ai

# Google Gemini AI Key
GEMINI_API_KEY=your-gemini-api-key-here

# JWT Secret (tạo chuỗi random mạnh, ít nhất 32 ký tự)
SECRET_KEY=your-super-secret-key-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Gmail SMTP (để gửi OTP đặt lịch)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER_NAME=CLINOVA Smart Clinic
