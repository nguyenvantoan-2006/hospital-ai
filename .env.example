# Clinova Clinical Management System - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Database Connection URL (MySQL / SQLite)
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/hospital_ai

# JWT Secret Key and Settings
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cấu hình Gửi Email Xác Thực Đặt Lịch (Gmail SMTP)
# Sử dụng App Password (Mật khẩu ứng dụng 16 ký tự của Google Account)
GMAIL_USER=your_clinic_email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER_NAME=CLINOVA Smart Clinic

