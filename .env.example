# .env.example — Biến môi trường mẫu cho Hệ thống Quản lý Phòng khám Hospital-AI (CLINOVA)
# Sao chép tệp này thành .env và điền các giá trị thực tế trước khi khởi chạy:
#   cp .env.example .env

# ─── CẤU HÌNH GOOGLE GEMINI AI ──────────────────────────────────────────────
# Khóa API Google Gemini (bắt buộc để chạy AI Chatbot, AI Summary, AI Guide)
# Lấy khóa miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── CẤU HÌNH CƠ SỞ DỮ LIỆU (DATABASE) ──────────────────────────────────────
# Khi chạy qua Docker Compose với MySQL:
DATABASE_URL=mysql+pymysql://clinic_user:clinic_secure_pass_2026@db:3306/hospital_ai

# Nếu chạy môi trường cục bộ độc lập với SQLite (không cần cài MySQL):
# DATABASE_URL=sqlite:///./clinic.db

# ─── BẢO MẬT XÁC THỰC (JWT AUTH & SECURITY) ─────────────────────────────────
# Khóa bí mật dùng để ký và xác thực mã JWT Token (sinh ngẫu nhiên 32+ ký tự)
# Ví dụ sinh khóa: openssl rand -hex 32
SECRET_KEY=your_super_secret_jwt_key_min_32_chars_change_in_production

# Thuật toán mã hóa JWT
ALGORITHM=HS256

# Thời hạn hiệu lực của Access Token (phút) — mặc định 480 phút (8 giờ làm việc)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── CẤU HÌNH GỬI EMAIL XÁC THỰC OTP (GMAIL SMTP) ───────────────────────────
# Tùy chọn: Dùng để gửi mã OTP khi bệnh nhân đặt lịch online (FR-09)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
GMAIL_USER=your_clinic_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_16_character_app_password
EMAIL_SENDER_NAME=CLINOVA Smart Clinic
